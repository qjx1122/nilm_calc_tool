{
  "name": "分路侧设备电气量",
  "sampling": {
    "fs": 6400.0,
    "f_nom": 50.0,
    "f_min": 45.0,
    "f_max": 65.0,
    "adaptive_freq": false,
    "fs_from_timestamps": true,
    "fs_tolerance": 0.01
  },
  "transform": {
    "pt_ratio": 100.0,
    "ct_ratio": 15.0,
    "voltage_input": "phase",
    "enabled": false
  },
  "harmonic": {
    "order_min": 2,
    "order_max": 50,
    "thd_order_max": 50,
    "include_interharmonic": true
  },
  "power": {
    "apparent": "arithmetic",
    "reactive": "harmonic_sum",
    "fundamental_power": true,
    "three_phase_mode": "four_wire"
  },
  "columns": {
    "timestamp": "时间戳",
    "ua": "A相电压",
    "ia": "A相电流",
    "ub": "B相电压",
    "ib": "B相电流",
    "uc": "C相电压",
    "ic": "C相电流",
    "encoding": "auto",
    "delimiter": ",",
    "has_header": true,
    "timestamp_unit": "auto",
    "mapping_enabled": false,
    "mapping": {
      "timestamp": "1",
      "ua": "2",
      "ia": "3",
      "ub": "4",
      "ib": "5",
      "uc": "6",
      "ic": "7"
    },
    "ALIASES": {
      "timestamp": [
        "时间戳",
        "时间",
        "时标",
        "timestamp",
        "time",
        "ts",
        "datetime",
        "date_time"
      ],
      "ua": [
        "a相电压",
        "ua",
        "u_a",
        "va",
        "v_a",
        "电压a",
        "phasea_voltage",
        "u_phase_a"
      ],
      "ia": [
        "a相电流",
        "ia",
        "i_a",
        "电流a",
        "phasea_current",
        "i_phase_a"
      ],
      "ub": [
        "b相电压",
        "ub",
        "u_b",
        "vb",
        "v_b",
        "电压b",
        "phaseb_voltage",
        "u_phase_b"
      ],
      "ib": [
        "b相电流",
        "ib",
        "i_b",
        "电流b",
        "phaseb_current",
        "i_phase_b"
      ],
      "uc": [
        "c相电压",
        "uc",
        "u_c",
        "vc",
        "v_c",
        "电压c",
        "phasec_voltage",
        "u_phase_c"
      ],
      "ic": [
        "c相电流",
        "ic",
        "i_c",
        "电流c",
        "phasec_current",
        "i_phase_c"
      ]
    }
  },
  "source": {
    "kind": "simulator",
    "path": "",
    "poll_interval_s": 0.2,
    "block_samples": 640,
    "tail_from_end": false,
    "watch_dir_newest": true,
    "host": "127.0.0.1",
    "port": 9000,
    "frame": "text_csv",
    "struct_fmt": "<7d",
    "struct_fields": "t,ua,ia,ub,ib,uc,ic",
    "struct_has_header": false,
    "sim_f": 50.0,
    "sim_harmonics": {
      "3": 0.08,
      "5": 0.06,
      "7": 0.03,
      "11": 0.015,
      "13": 0.01
    },
    "sim_noise_ratio": 0.002,
    "sim_unbalance": 0.02,
    "sim_speed": 1.0,
    "custom_time": false,
    "custom_time_start": "",
    "file_time_utc": false,
    "play_start_mode": "begin",
    "file_speed": 0.0,
    "play_start_value": ""
  },
  "output": {
    "history_len": 600,
    "history_hours": 24.0,
    "history_max_points": 500000,
    "export_dir": "output",
    "spectrum_max_points": 1600,
    "curve_save": {
      "voltage": true,
      "current": true,
      "power": true,
      "power_factor": true,
      "fundamental": true,
      "harmonic": true,
      "interharmonic": true,
      "dc": true
    },
    "realtime_save": true,
    "realtime_dir": "output/realtime"
  },
  "events": {
    "enabled": true,
    "hysteresis": 0.95,
    "save": true,
    "events_dir": "output/events",
    "max_log": 2000,
    "limits_secondary": true,
    "u_nom": 57.74,
    "u1_high_pct": 110.0,
    "u1_low_pct": 90.0,
    "i1_high": 6.0,
    "hr_u_limit_pct": 5.0,
    "hr_i_limit_pct": 10.0,
    "thd_u_limit_pct": 5.0,
    "thd_i_limit_pct": 10.0,
    "ih_u_limit_pct": 1.0,
    "ih_i_limit_pct": 2.0,
    "f_low": 49.5,
