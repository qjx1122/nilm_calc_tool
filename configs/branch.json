    "osc_f_min": 0.1,
    "osc_f_max": 2.5,
    "osc_limit_pct": 5.0,
    "osc_min_w": 1.0,
    "osc_min_points": 8
  },
  "nilm": {
    "enabled": true,
    "save": true,
    "nilm_dir": "output/nilm",
    "max_log": 5000,
    "channels": [
      "total"
    ],
    "window_cycles": 300,
    "min_gap_cycles": 10,
    "rel_tol_pct": 1.0,
    "min_delta_pct": 0.0,
    "algorithms": {
      "threshold": {
        "enabled": true,
        "min_delta_w": 50.0,
        "settle_cycles": 5,
        "settle_tol_w": 20.0,
        "max_rise_cycles": 40
      },
      "two_window": {
        "enabled": true,
        "pre_cycles": 10,
        "post_cycles": 10,
        "min_delta_w": 50.0,
        "k_sigma": 3.0
      },
      "cusum": {
        "enabled": true,
        "drift_w": 10.0,
        "threshold_w": 200.0,
        "min_delta_w": 50.0,
        "settle_cycles": 5
      },
      "glr": {
        "enabled": true,
        "window_cycles": 15,
        "threshold": 25.0,
        "min_delta_w": 50.0,
        "noise_w": 10.0,
        "settle_cycles": 5
      },
      "steady_state": {
        "enabled": true,
        "tol_w": 30.0,
        "min_steady_cycles": 10,
        "min_delta_w": 50.0,
        "max_transient_cycles": 100
      },
      "median_diff": {
        "enabled": true,
        "median_cycles": 5,
        "min_delta_w": 50.0,
        "settle_cycles": 5,
        "settle_tol_w": 20.0,
        "max_rise_cycles": 40
      }
    }
  },
  "branch": {
    "enabled": false,
    "config_path": "configs/branch.json",
